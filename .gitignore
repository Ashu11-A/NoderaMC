# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
# IDE (Eclipse/VSCode-Java) compile output inside each module — never committed.
# Eclipse/redhat.java compile the tree into `<module>/bin/{main,test}` beside Gradle's `build/`.
# Matched at ANY depth on purpose: the previous pattern was `java/*/bin/`, which stopped covering
# anything the moment modules moved out of `java/`, and a `git add -A` then committed 1,127 .class
# files. Anchored on `bin/main` and `bin/test` rather than a bare `bin/` so that Cargo's own
# `tracker/src/bin/` convention — which holds real source — keeps working.
**/bin/main/
**/bin/test/
.vscode/
.eclipse/
.classpath
.project
.settings/

# OS
.DS_Store

# Nodera runtime artifacts (anchored to repo root — an unanchored `nodera/` would also
# match the `dev/nodera/` source package in every module and silently hide new source files).
/nodera/
/divergences/
/world-store/

# NOTE: third-party architecture-study clones are NOT ignored. They live in
# docs/minecraft/upstream/ as pinned submodules (see .gitmodules) so a study document and
# the upstream commit it describes cannot drift apart. The two rules that used to sit here
# pointed at docs/Context/, a directory deleted in the 2026-07-25 docs reorg.

# jqwik property-test database (runtime artifact)
.jqwik-database

# Local NeoForge dedicated-server install (created by scripts/setup-server.sh):
# downloaded NeoForge libraries, world saves, logs, the copied mod jar — never committed.
/run/

# Stray Minecraft/NeoForge runtime logs if a server is ever launched from the repo root.
/logs/
/latest.log
/debug.log
/crash-reports/
hs_err_pid*.log

# Local API-token / env files — MUST never be committed (contain ANTHROPIC_AUTH_TOKEN etc.)
claude_code_zai_env.sh
/a
*.env
.env

# Rust build output (cargo workspace under rust/, Task 27).
/target/

# Local agent/plugin settings (per-machine, not project config).
/.claude/

# NeoForge dev runs (MDG runClient/runServer/runClientJoin game dirs)
endpoints/neoforge-mod/run/
endpoints/neoforge-mod/run-join/
endpoints/neoforge-mod/run-join2/
endpoints/neoforge-mod/run-join3/
endpoints/neoforge-mod/run-host/

# Telemetry deployment (docker/telemetry/) — secrets, TLS material, and collected data never land
# in git. The .example files and the configuration ARE committed; what they point at is not.
docker/telemetry/.env
docker/telemetry/edge/certs/*
!docker/telemetry/edge/certs/.gitkeep
telemetry-spool/

# Kotlin build-daemon crash logs from build-logic (per-machine, never useful in git).
library/java/build-logic/.kotlin/

# Python bytecode (the Spark jobs are sources, never build output).
__pycache__/
*.pyc

# Service node identities. A locally started tracker or rendezvous writes its Ed25519 secret key
# next to the working directory it was launched from, so these appear wherever a service was run.
# They are private keys: committing one hands over the identity of that node permanently.
*-identity.bin

# Signing key material. A safety net, not a workflow: the Android release keystore lives outside
# this repository and reaches CI as a secret. This exists because the cost of one accidental
# `git add -A` is unbounded — an Android signing key that leaks cannot be rotated, since Android
# identifies an app by its certificate and every existing install would refuse an update signed by
# a new one.
*.jks
*.keystore
*.p12
*.pfx
