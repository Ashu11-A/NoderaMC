# Copy to `.env` beside compose.yml and edit. Every variable here is read by docker/compose.yml.
#
# The three without defaults are required, and compose refuses to start without them rather than
# starting something that looks healthy and is unreachable.

# Which published build to run. `latest` is the stable release; `canary` is built from every push to
# main and is what the project's own deployment runs.
NODERA_IMAGE_TAG=latest

# --- required ---------------------------------------------------------------------------------

# The address peers should use to reach your tracker. This is what the tracker publishes about
# itself, so it must be the PUBLIC name and port, not the container's bind address. Comma-separate
# to advertise more than one route (for example an IPv4 and an IPv6 name).
NODERA_TRACKER_ADVERTISED_ROUTES=tcp://tracker.example.org:6969

# The address peers should use to reach your relay.
NODERA_RENDEZVOUS_ADVERTISED_ROUTES=tcp://relay.example.org:7500

# The tracker(s) your relay announces itself to. A relay that announces nowhere is reachable only by
# peers that already have its address — which is the discovery lane not working. Point this at your
# own tracker, at the project's, or at both.
#
# Running BOTH services from this compose file? Use the service name: `tcp://tracker:6969`. It is
# not just tidier — a container reaching its own host's public address has to hairpin back through
# the published port, and on a default bridge network that is simply refused.
NODERA_RENDEZVOUS_TRACKER_ENDPOINTS=tcp://tracker:6969

# --- optional ---------------------------------------------------------------------------------

# Host ports. Change these if 6969/7500 are taken; the container ports stay the same.
NODERA_TRACKER_PORT=6969
NODERA_RENDEZVOUS_PORT=7500

# Keeps relay reservation proofs valid across a restart. Generate with:
#   openssl rand -hex 32
# Leave empty to mint an ephemeral key at every boot — correct, but every outstanding reservation is
# invalidated whenever the process restarts.
NODERA_RENDEZVOUS_RESERVATION_HMAC_KEY_HEX=

# How many concurrent circuits this relay advertises headroom for. 0 means "unstated", which is
# honest for a host you have not measured. Setting it lets peers prefer a relay with room over a
# saturated one — it is advertised, not enforced.
NODERA_RENDEZVOUS_MAX_CONCURRENT_CIRCUITS=0

# How long a drain waits for in-flight circuits before the stop proceeds anyway. Raising this beyond
# compose's `stop_grace_period` achieves nothing: Docker kills the container first.
NODERA_RENDEZVOUS_DRAIN_GRACE_SECONDS=30

# Tracker bounds. Both defaults are deliberately conservative for an unauthenticated,
# internet-facing service; raise them knowingly.
NODERA_TRACKER_MAX_SERVICES=256
NODERA_TRACKER_PER_IP_ANNOUNCE_QUOTA=60
