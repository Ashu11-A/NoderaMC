# Copy to .env and fill in. Never commit the filled-in file.
#
# The pseudonymisation key. Rotating it makes every previously stored subject unlinkable to any new
# one — which is a privacy improvement and a retention-analysis outage at the same time, so change
# it deliberately. Generate with: openssl rand -hex 32
NODERA_TELEMETRY_SUBJECT_SECRET=change-me

CLICKHOUSE_USER=nodera
CLICKHOUSE_PASSWORD=change-me
GRAFANA_PASSWORD=change-me

# Public TLS port, used only with `--profile public`.
NODERA_TELEMETRY_TLS_PORT=25621
