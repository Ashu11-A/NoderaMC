# Copy to .env and fill in. Never commit the filled-in file.
#
# No pseudonymisation secret belongs here. Each rotation period the ingest process mints a fresh
# key from the OS CSPRNG and holds it only in memory, wiping it on rotation
# (docs/telemetry/LIMITATIONS.fixed.md L-72). An operator with this file still cannot reproduce a
# previous period's subjects, because no key material is ever written down.

CLICKHOUSE_USER=nodera
CLICKHOUSE_PASSWORD=change-me
GRAFANA_PASSWORD=change-me

# Public TLS port, used only with `--profile public`.
NODERA_TELEMETRY_TLS_PORT=25621
