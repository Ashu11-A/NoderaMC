{
  "name": "nodera-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/fetch-release.mjs && node scripts/build-services.mjs && node scripts/build-status.mjs && node scripts/build-tokens.mjs && node scripts/mirror-docs.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --ssr && node scripts/prerender.mjs",
    "postbuild": "node scripts/sitemap.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "dev": "vite"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "nodera-app-ui": "workspace:*",
    "nodera-ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.0",
    "@shikijs/rehype": "^1.24.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^3.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx-frontmatter": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "unist-util-visit": "^5.0.0",
    "vite": "^5.4.0"
  }
}
